<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="912.0" prefWidth="1283.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eric.javablock.HelloController">
   <top>
      <HBox spacing="10.0" style="-fx-background-color: #E0E0E0;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
         </padding>
            <Button text="💾 儲存專案 (Ctrl+S)" onAction="#onSaveProject" />
            <Button text="💾 另存新檔" onAction="#onSaveAsProject" />
            <Button text="📂 開啟專案" onAction="#onLoadProject" />
            <Button text="🏠 開啟/設定預設目錄" onAction="#onManageDefaultDirectory" />
      </HBox>
   </top>
   <left>
      <VBox fx:id="paletteBox" alignment="TOP_CENTER" prefHeight="200.0" prefWidth="100.0" spacing="10.0" style="-fx-background-color: #F4F4F4;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </left>
   <center>
      <javafx.scene.layout.StackPane BorderPane.alignment="CENTER">
         <children>
            <javafx.scene.control.ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED">
               <content>
                  <AnchorPane fx:id="workspace" prefHeight="2000.0" prefWidth="2000.0" style="-fx-background-color: #FFFFFF;">
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </AnchorPane>
               </content>
            </javafx.scene.control.ScrollPane>

            <AnchorPane fx:id="fixedOverlay" mouseTransparent="false" pickOnBounds="false" />
         </children>
      </javafx.scene.layout.StackPane>
   </center>
   <bottom>
      <HBox prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER" />
   </bottom>
   <right>
      <VBox prefWidth="200.0" spacing="5.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
         <TextArea fx:id="codePreview" prefHeight="500.0" prefWidth="200.0" />
         <Button text="▶ 執行" onAction="#onRunCode" maxWidth="Infinity" />
         <TextArea fx:id="outputArea" prefHeight="200.0" prefWidth="200.0" editable="false" promptText="執行結果會顯示在這裡..." />
      </VBox>
   </right>
</BorderPane>
